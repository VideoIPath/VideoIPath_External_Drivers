# Complete public configuration inventory. All options below require recreate/restart.
# Only VIDEOIPATH_TOKEN is secret; other options are nonsecret operational metadata.
# Single-quote literal values containing $, #, whitespace or double quotes; see OPERATIONS.md.
# Empty required values intentionally prevent an unedited deployment from starting.

# REQUIRED, NONSECRET, UNIQUE: lowercase Compose project name [a-z0-9][a-z0-9_-]*.
COMPOSE_PROJECT_NAME=
# REQUIRED, NONSECRET, UPGRADE/ACCEPTANCE: immutable image tag, preferably registry@sha256:digest.
DRIVER_IMAGE=
# OPTIONAL, NONSECRET: no, on-failure[:N], always, or unless-stopped; default five retries.
# Unbounded policies require equivalent external permanent-fault suppression and alerting.
DRIVER_RESTART_POLICY=on-failure:5
# OPTIONAL, NONSECRET: existing host directory of public CA certificates, mounted read-only.
DRIVER_CERTIFICATE_HOST_PATH=./deployment/certificates
# OPTIONAL, NONSECRET: SAME absolute host directory for all projects; owner 10001:10001, mode 0700.
DRIVER_LOCK_HOST_PATH=/var/lock/videoipath-drivers
# OPTIONAL, NONSECRET: Docker duration, greater than DRIVER_SHUTDOWN_TIMEOUT_MS.
DRIVER_STOP_GRACE_PERIOD=20s
# OPTIONAL, NONSECRET: positive Docker duration between local liveness probes.
DRIVER_HEALTHCHECK_INTERVAL=30s
# OPTIONAL, NONSECRET: positive Docker duration bounding each local liveness probe.
DRIVER_HEALTHCHECK_TIMEOUT=5s
# OPTIONAL, NONSECRET: positive integer failed probes before unhealthy.
DRIVER_HEALTHCHECK_RETRIES=3
# OPTIONAL, NONSECRET: nonnegative Docker startup-grace duration.
DRIVER_HEALTHCHECK_START_PERIOD=15s
# OPTIONAL, NONSECRET, LOAD-TEST: positive CPU cores per service.
DRIVER_CPU_LIMIT=0.50
# OPTIONAL, NONSECRET, LOAD-TEST: positive Docker memory size per service.
DRIVER_MEMORY_LIMIT=256m
# OPTIONAL, NONSECRET, LOAD-TEST: positive process/thread limit per service.
DRIVER_PIDS_LIMIT=128
# OPTIONAL, NONSECRET: Docker local-log size per file, e.g. 10m.
DRIVER_LOG_MAX_SIZE=10m
# OPTIONAL, NONSECRET: positive integer retained log-file count per service.
DRIVER_LOG_MAX_FILES=5

# REQUIRED, NONSECRET, ACCEPTANCE: wss URL ending /x-driver/v1, no query, fragment or credentials.
VIDEOIPATH_URL=wss://videoipath.example.invalid/x-driver/v1
# REQUIRED, SECRET: non-placeholder bearer token; no URL/CLI token or *_FILE support.
VIDEOIPATH_TOKEN=
# REQUIRED, NONSECRET, UNIQUE/REDISCOVERY: provision a stable non-nil UUID once per target.
VIDEOIPATH_NODE_ID=
# OPTIONAL, NONSECRET: absolute in-container PEM CA path under /etc/rust-example/certificates;
# empty uses normal trust roots. The host file is public trust material, never a CA private key.
VIDEOIPATH_CA_BUNDLE=

# OPTIONAL, NONSECRET: absolute driver heartbeat/state directory; named volume mounted here.
# Keep the Compose default unless you also prepare volume ownership (see OPERATIONS.md).
DRIVER_STATE_DIRECTORY=/var/lib/rust-example
# OPTIONAL, NONSECRET: absolute in-container lock directory; common host bind is mounted here.
DRIVER_LOCK_DIRECTORY=/var/lock/videoipath-drivers
# OPTIONAL, NONSECRET: trace, debug, info, warn, or error; no detailed payload logging.
DRIVER_LOG_LEVEL=info
# OPTIONAL, RESTART + INVENTORY SYNC: senders_first, receivers_first, or all.
# Changes structure metadata; revalidate saved consumers and routing after changing it.
DRIVER_CONFIGURATION_ORDER=senders_first
# OPTIONAL, NONSECRET, LOAD-TEST: 1..256 maximum concurrent requests.
DRIVER_REQUEST_LIMIT=16
# OPTIONAL, NONSECRET, LOAD-TEST: 2..4096 outbound queue capacity in messages.
DRIVER_OUTBOUND_LIMIT=128
# OPTIONAL, NONSECRET, LOAD-TEST: 1024..4194304 maximum incoming frame size in bytes.
DRIVER_MAX_FRAME_BYTES=1048576
# OPTIONAL, NONSECRET, ACCEPTANCE: 100..7000 ms ordinary deadline; request <= IPT.
DRIVER_REQUEST_TIMEOUT_MS=5000
# OPTIONAL, NONSECRET, ACCEPTANCE: 100..25000 ms IPT deadline; >= ordinary request deadline.
DRIVER_IPT_TIMEOUT_MS=20000
# OPTIONAL, NONSECRET: 100..30000 ms minimum reconnect delay; <= maximum.
DRIVER_RECONNECT_MIN_MS=500
# OPTIONAL, NONSECRET: 100..120000 ms maximum reconnect delay; >= minimum.
DRIVER_RECONNECT_MAX_MS=30000
# OPTIONAL, NONSECRET: 100..10000 ms shutdown deadline; < Compose stop grace.
DRIVER_SHUTDOWN_TIMEOUT_MS=5000
